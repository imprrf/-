/* pages/privacy/privacy.wxss - 隐私政策样式 */

.privacy-container {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

.header {
  background: #1890ff;
  padding: 32rpx 32rpx 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
}

.content {
  flex: 1;
  padding: 32rpx;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.paragraph {
  display: block;
  font-size: 28rpx;
  color: #4a4a4a;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.highlight {
  color: #1890ff;
  font-weight: 500;
}

.contact {
  background: #f5f7fa;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.link {
  color: #1890ff;
  text-decoration: underline;
}

.update-date {
  display: block;
  font-size: 24rpx;
  color: #999999;
  text-align: right;
  margin-top: 16rpx;
}
